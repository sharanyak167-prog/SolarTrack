# Copy this file to .env, then supply your own secret; never share .env.
JWT_SECRET_KEY=
EXTRACTION_MODE=mock
# To use live extraction, set EXTRACTION_MODE=gemini and provide a key:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Optional: defaults are a local SQLite database and uploads/ folder.
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/solar_monitor
# UPLOAD_DIR=C:/SolarTrack/uploads
